# StayNear College Environment Configuration
# Copy this file to .env and configure your keys if using external Supabase / Google Maps services.
# Note: The application operates with zero external configuration out-of-the-box using OpenStreetMap and local persistence!

# Supabase Database & Auth (Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps API Key (Optional - Leaflet/OpenStreetMap is active by default)
VITE_GOOGLE_MAPS_API_KEY=
